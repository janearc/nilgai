# vim: set filetype=game:
# Nilgai: a common source record for astronomy catalogues.
name nilgai

lint width 80
lint rows 25
lint comments
lint print
lint exclaim
lint shout
lint words hyperscaler enterprise-grade blazing-fast load-bearing
lint paragraph 4

lint allow README.md words paragraph rows

# this is stuff that necessarily names me
sweep allow README.md emails author 
sweep allow cmd/nilgai/orbits.yaml author 
sweep allow searches/firang/cmd/firang/testdata/numbers.yaml author
sweep allow searches/firang/numbers.yaml author 

# shouty stuffins
lint abbreviations APOGEE ASPCAP DOWNLOADED DREAMS GALAH GBTDS GRAVITY
lint abbreviations GSAOI HARPS LAMOST MACHO MARCS METIS MNRAS PRIME SIMBAD
lint abbreviations TIMEOUT UKIRT

# by definition this is going to have a lot of data that we don't have the
# rights to publish, but can be mechanically generated by anyone who
# downloads the software and has permission to download them themself.
omit searches/firang/data
exclude searches/firang/data
omit searches/firang/sources
exclude searches/firang/sources
