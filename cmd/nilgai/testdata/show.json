    {"name": "more pixels than the style allows", "args": ["--chandra", "{chandra}", "--ra", "266.4", "--dec", "-29.0", "--width", "12", "--pixels", "4097"], "want": ["4097", "limit"]},
    {"name": "width not a number","args": ["--chandra", "{chandra}", "--ra", "266.4", "--dec", "-29.0", "--width", "wide", "--pixels", "300"], "want": ["--width"]},
