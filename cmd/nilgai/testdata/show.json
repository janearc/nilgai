    {"name": "right ascension past a full circle", "args": ["--chandra", "{chandra}", "--ra", "400", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["400"]},
    {"name": "no width above zero", "args": ["--chandra", "{chandra}", "--ra", "266.4", "--dec", "-29.0", "--width", "0", "--pixels", "300"], "want": ["cannot be drawn"]},
    {"name": "no pixels above zero", "args": ["--chandra", "{chandra}", "--ra", "266.4", "--dec", "-29.0", "--width", "12", "--pixels", "0"], "want": ["cannot be drawn"]},
    {"name": "no catalogue named", "args": ["--ra", "266.4", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["--chandra", "--allwise", "--fermi"]},
    {"name": "a file that is not there", "args": ["--chandra", "{missing}", "--ra", "266.4", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["missing"]},
    {"name": "a fermi file that is not there", "args": ["--fermi", "{missing}", "--ra", "266.4", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["missing"]},
    {"name": "a search that is no table", "args": ["--chandra", "{notATable}", "--ra", "266.4", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["notATable"]},
    {"name": "an allwise search given as chandra's", "args": ["--chandra", "{allwise}", "--ra", "266.4", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["allwise"]},
    {"name": "a search given as fermi's", "args": ["--fermi", "{chandra}", "--ra", "266.4", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["chandra"]}
  ],
  "unread": [
    {"name": "a chandra row that is not a number", "args": ["--chandra", "{chandraRows}", "--ra", "266.4168371", "--dec", "-29.0078106", "--width", "12", "--pixels", "300"], "want": ["row 2", "column ra"]},
    {"name": "an allwise row that is not a number", "args": ["--allwise", "{allwiseRows}", "--ra", "266.4168371", "--dec", "-29.0078106", "--width", "12", "--pixels", "300"], "want": ["row 2", "column ra"]},
    {"name": "an extended source in fermi", "args": ["--fermi", "{fermiExtended}", "--ra", "266.4168371", "--dec", "-29.0078106", "--width", "12", "--pixels", "300"], "want": ["row 2", "extended source"]},
    {"name": "rows unread in two files are both named", "args": ["--chandra", "{chandraRows}", "--allwise", "{allwiseRows}", "--ra", "266.4168371", "--dec", "-29.0078106", "--width", "12", "--pixels", "300"], "want": ["chandra", "allwise", "column ra"]}
  ]
