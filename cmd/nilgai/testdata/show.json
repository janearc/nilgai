{
  "source": "What nilgai show must refuse and draw. files are written to a temporary directory for each test and named in args by {name}, with {missing} a file that is not there: chandra and allwise are searches with one good row; chandraRows and allwiseRows add a row whose right ascension is not a number, which show names after it has drawn the rest; notATable is text that is no search at all. fermi and fermiExtended are written as 4FGL-shaped FITS tables by the test, the second adding an extended source, which has no ellipse and so is named. Positions are Sgr A* as in the repository's testdata. 300 pixels across for 12 arcsec; two panels of 300 pixels with the 24 pixel gap data/sky.json gives is 300 + 24 + 300 = 624 wide. repeats is how many times the same call is made to show it draws the same picture each time; it is picked. A refused call exits 1, or the code it gives (2, when the flags themselves are wrong and nothing ran), writes nothing to standard output, and says every word in want on standard error. A list of widths is given as one flag, 12,6, and the same flag twice is refused.",
  "chandraHeader": "name\tra\tdec\terr_ellipse_r0\terr_ellipse_r1\terr_ellipse_ang\tflux_aper_b\tflux_aper_lolim_b\tflux_aper_hilim_b\n",
  "chandraGood": "2CXO J1\t266.4168\t-29.0078\t0.7\t0.7\t0\t1e-13\t0.9e-13\t1.1e-13\n",
  "chandraBad": "2CXO J2\tnorth\t-29.0078\t0.7\t0.7\t0\t1e-13\t0.9e-13\t1.1e-13\n",
  "allwiseHeader": "designation,ra,dec,sigra,sigdec,sigradec,w1mpro,w1sigmpro,cc_flags,ph_qual\n",
  "allwiseGood": "J1,266.41685,-29.00785,0.2,0.2,0,15,0.1,0000,AAAA\n",
  "allwiseBad": "J2,north,-29.0,0.2,0.2,0,15,0.1,0000,AAAA\n",
  "notATable": "this is not a search\n",
  "columns": [
    {"name": "Source_Name", "format": "20A"},
    {"name": "RAJ2000", "format": "E"},
    {"name": "DEJ2000", "format": "E"},
    {"name": "Conf_95_SemiMajor", "format": "E"},
    {"name": "Conf_95_SemiMinor", "format": "E"},
    {"name": "Conf_95_PosAng", "format": "E"},
    {"name": "Energy_Flux100", "format": "E"},
    {"name": "Unc_Energy_Flux100", "format": "E"},
    {"name": "CLASS1", "format": "5A"},
    {"name": "ASSOC1", "format": "28A"},
    {"name": "Flags", "format": "I"}
  ],
  "fermiGood": {"name": "4FGL J1745.6-2859", "ra": 266.4168, "dec": -29.0078, "major": 0.001, "minor": 0.0005, "angle": 30, "flux": 1e-11, "fluxError": 1e-12},
  "fermiExtended": {"name": "4FGL J1745.6-2900e", "ra": 266.4168, "dec": -29.0078, "major": "NaN", "minor": "NaN", "angle": "NaN", "flux": 1e-11, "fluxError": 1e-12},
  "pixels": 300,
  "panels": {"widths": ["12", "6"], "bounds": "(0,0)-(624,300)"},
  "repeats": 8,
  "draw": [
    {"name": "Chandra alone", "args": ["--chandra", "{chandra}", "--ra", "266.4168371", "--dec", "-29.0078106", "--width", "12", "--pixels", "300"]},
    {"name": "AllWISE alone", "args": ["--allwise", "{allwise}", "--ra", "266.4168371", "--dec", "-29.0078106", "--width", "12", "--pixels", "300"]},
    {"name": "Fermi alone", "args": ["--fermi", "{fermi}", "--ra", "266.4168371", "--dec", "-29.0078106", "--width", "12", "--pixels", "300"]},
    {"name": "all three, with short flags", "args": ["-c", "{chandra}", "-a", "{allwise}", "-f", "{fermi}", "--ra", "266.4168371", "--dec", "-29.0078106", "-w", "12", "-p", "300"]}
  ],
  "refused": [
    {"name": "no right ascension", "args": ["--chandra", "{chandra}", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["--ra"]},
    {"name": "no declination", "args": ["--chandra", "{chandra}", "--ra", "266.4", "--width", "12", "--pixels", "300"], "want": ["--dec"]},
    {"name": "no width", "args": ["--chandra", "{chandra}", "--ra", "266.4", "--dec", "-29.0", "--pixels", "300"], "want": ["--width"]},
    {"name": "no pixels", "args": ["--chandra", "{chandra}", "--ra", "266.4", "--dec", "-29.0", "--width", "12"], "want": ["--pixels"]},
    {"name": "right ascension not a number", "args": ["--chandra", "{chandra}", "--ra", "north", "--dec", "-29.0", "--width", "12", "--pixels", "300"], "want": ["--ra"]},
